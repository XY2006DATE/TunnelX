{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelX",
  "version": "0.1.0",
  "identifier": "cn.xcloudy.tunnelx.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dashboard/web"
  },
  "app": {
    "windows": [
      {
        "title": "TunnelX",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tunnelx-client"
    ],
    "resources": {
      "../../client.yaml": "client.yaml"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
