{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TunnelX Server",
  "version": "0.1.0",
  "identifier": "cn.xcloudy.tunnelx.server",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../dashboard/web"
  },
  "app": {
    "windows": [
      {
        "title": "TunnelX Server",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tunnelx-server"
    ],
    "resources": {
      "../../server.yaml": "server.yaml"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
